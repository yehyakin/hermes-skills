"use client";

import { useState, useEffect, useCallback } from "react";
import Link from "next/link";
import LiquidBackground from "@/components/liquid/LiquidBackground";
import LiquidPanel from "@/components/liquid/LiquidPanel";
import LiquidBadge from "@/components/liquid/LiquidBadge";
import { ClientOnlyText } from "@/components/ClientOnlyText";

// ─── Types ───────────────────────────────────────────────────────────────────

interface Task {
  id: string;
  task_id: string;
  source: string;
  sender: string | null;
  original_message: string | null;
  task_type: string;
  assigned_agent: string;
  priority: string;
  risk_level: string;
  requires_confirmation: number;
  status: string;
  created_at: string;
  started_at?: string;
  completed_at?: string;
  duration_seconds?: number | null;
  memory_path?: string | null;
  memory_type?: string | null;
  memory_written_at?: string | null;
  result_summary?: string | null;
  error_message?: string | null;
  failed_step?: string | null;
  retryable?: number;
  suggested_next_action?: string | null;
  routing_reason?: string | null;
  matched_capability?: string | null;
  idempotency_key?: string | null;
  external_task_id?: string | null;
  project?: string | null;
  claimed_by?: string | null;
  claimed_at?: string | null;
  retry_count?: number;
  max_retries?: number;
  provider?: string | null;
  external_status?: string | null;
  external_created_at?: string | null;
  external_last_poll_at?: string | null;
  external_result_url?: string | null;
  external_error_code?: string | null;
  external_error_message?: string | null;
  billing_risk_level?: string | null;
  asset_ids?: string[] | null;
}

// ─── Status Config ────────────────────────────────────────────────────────────

type StatusTone = "green" | "violet" | "amber" | "red" | "slate" | "cyan";

interface StatusConfig {
  tone: StatusTone;
  label: string;
  short: string;
}

const STATUS_CONFIG: Record<string, StatusConfig> = {
  pending:               { tone: "amber",  label: "Pending",               short: "Pend"    },
  pending_confirmation:  { tone: "red",    label: "Confirm Required",       short: "Conf"    },
  confirmed:            { tone: "cyan",   label: "Confirmed",              short: "Conf"    },
  running:             { tone: "violet", label: "Running",                short: "Run"     },
  waiting_for_agent:   { tone: "amber",  label: "Waiting for Agent",     short: "Wait"    },
  dry_run_pending:     { tone: "cyan",   label: "Dry Run Pending",       short: "Dry"     },
  external_created:    { tone: "cyan",   label: "External Created",      short: "Ext Cr"  },
  external_polling:    { tone: "violet", label: "External Polling",       short: "Ext Pol" },
  external_completed:  { tone: "green",  label: "External Completed",     short: "Ext Ok"  },
  external_failed:     { tone: "red",    label: "External Failed",        short: "Ext Fail"},
  recoverable_timeout: { tone: "amber",  label: "Recoverable Timeout",   short: "Recov"   },
  completed:           { tone: "green",  label: "Completed",              short: "Done"    },
  failed:             { tone: "red",    label: "Failed",                 short: "Fail"    },
  cancelled:          { tone: "slate",  label: "Cancelled",              short: "Canc"    },
  invalidated:        { tone: "slate",  label: "Invalidated",           short: "Inv"     },
  unknown:            { tone: "slate",  label: "Unknown",               short: "?"       },
};

function getStatus(s: string): StatusConfig {
  return STATUS_CONFIG[s] ?? STATUS_CONFIG["unknown"];
}

// ─── Helpers ─────────────────────────────────────────────────────────────────

function formatRelative(dateStr: string | null | undefined): string {
  if (!dateStr) return "—";
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 1)   return "Just now";
  if (mins < 60)  return `${mins}m ago`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24)   return `${hrs}h ago`;
  return `${Math.floor(hrs / 24)}d ago`;
}

function formatDuration(s: number | null | undefined): string {
  if (s == null) return "—";
  if (s < 60)    return `${s}s`;
  if (s < 3600)  return `${Math.floor(s / 60)}m`;
  return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;
}

function billingTone(level: string | null | undefined): StatusTone {
  if (level === "high")   return "red";
  if (level === "medium") return "amber";
  if (level === "low")    return "green";
  return "slate";
}

function riskTone(level: string | undefined): StatusTone {
  if (level === "critical") return "red";
  if (level === "high")      return "red";
  if (level === "medium")    return "amber";
  if (level === "low")       return "green";
  return "slate";
}

function isExternal(s: string): boolean {
  return s.startsWith("external_");
}

function isRecoverable(s: string): boolean {
  return s === "recoverable_timeout";
}

function isBillingRisk(task: Task): boolean {
  return task.billing_risk_level === "high" || task.billing_risk_level === "medium";
}

function isHighRisk(task: Task): boolean {
  return task.risk_level === "high" || task.risk_level === "critical";
}

function hasMemory(task: Task): boolean {
  return !!(task.memory_path || task.memory_written_at);
}

// ─── Defensive parsers ────────────────────────────────────────────────────────

function getArray<T>(json: unknown, fallback: T[] = []): T[] {
  if (Array.isArray(json)) return json as T[];
  if (json && typeof json === "object" && Array.isArray((json as { data?: unknown }).data)) {
    return (json as { data: T[] }).data;
  }
  return fallback;
}

function getObject<T>(json: unknown): T | null {
  if (!json || typeof json !== "object") return null;
  const o = json as { data?: unknown };
  if (o.data && typeof o.data === "object") return o.data as T;
  return json as T;
}

// ─── Filter config ───────────────────────────────────────────────────────────

const FILTERS = [
  { key: "all",              label: "All"            },
  { key: "running",          label: "Running"         },
  { key: "pending",          label: "Pending"         },
  { key: "confirm",          label: "Confirm"         },
  { key: "external",         label: "External"        },
  { key: "recoverable",      label: "Recoverable"      },
  { key: "completed",        label: "Completed"       },
  { key: "failed",           label: "Failed"          },
  { key: "high_risk",        label: "High Risk"        },
  { key: "billing_risk",     label: "Billing Risk"     },
  { key: "cancelled",        label: "Cancelled"        },
];

function matchFilter(task: Task, filter: string): boolean {
  if (filter === "all")           return true;
  if (filter === "running")       return task.status === "running";
  if (filter === "pending")       return task.status === "pending" || task.status === "waiting_for_agent";
  if (filter === "confirm")       return task.status === "pending_confirmation";
  if (filter === "external")      return isExternal(task.status);
  if (filter === "recoverable")  return isRecoverable(task.status);
  if (filter === "completed")     return task.status === "completed";
  if (filter === "failed")        return task.status === "failed";
  if (filter === "high_risk")    return isHighRisk(task);
  if (filter === "billing_risk") return isBillingRisk(task);
  if (filter === "cancelled")     return task.status === "cancelled" || task.status === "invalidated";
  return task.status === filter;
}

// ─── Defensive parsers ────────────────────────────────────────────────────────

function parseArrayField(value: unknown): string[] {
  if (Array.isArray(value)) return value.filter(Boolean).map(v => String(v));
  if (typeof value === "string") {
    try {
      const parsed = JSON.parse(value);
      if (Array.isArray(parsed)) return parsed.filter(Boolean).map(v => String(v));
    } catch {
      return value.split(",").map(v => v.trim()).filter(Boolean);
    }
  }
  return [];
}

// ─── Task Row ────────────────────────────────────────────────────────────────

function TaskRow({ task }: { task: Task }) {
  const sc   = getStatus(task.status);
  const href = `/tasks/${encodeURIComponent(task.task_id || task.id)}`;
  const rawAssets = task.asset_ids as unknown;
  const assets = parseArrayField(rawAssets);
  const extId = task.external_task_id;
  const mem   = hasMemory(task);

  return (
    <Link href={href} className="block group">
      <div
        className="flex items-center gap-3 px-4 py-2.5 rounded-xl transition-all duration-150 hover:translate-x-1"
        style={{
          background: "rgba(8, 12, 22, 0.42)",
          border: "1px solid rgba(148, 163, 184, 0.08)",
        }}
      >
        {/* Status */}
        <div className="shrink-0 w-28">
          <LiquidBadge tone={sc.tone} size="sm" label={sc.short} />
        </div>

        {/* Task ID + project */}
        <div className="w-44 shrink-0 overflow-hidden">
          <div className="text-xs font-mono text-cyan-400 truncate">
            {task.task_id || task.id.slice(0, 16)}
          </div>
          {task.project && (
            <div className="text-xs text-slate-500 truncate">{task.project}</div>
          )}
        </div>

        {/* Agent */}
        <div className="w-28 shrink-0">
          <span
            className="text-xs px-1.5 py-0.5 rounded-md font-medium"
            style={{
              background: task.assigned_agent === "hermes"
                ? "rgba(167,139,250,0.12)"
                : task.assigned_agent === "openclaw"
                ? "rgba(251,191,36,0.12)"
                : "rgba(148,163,184,0.08)",
              color: task.assigned_agent === "hermes"
                ? "#a78bfa"
                : task.assigned_agent === "openclaw"
                ? "#fbbf24"
                : "#94a3b8",
            }}
          >
            {task.assigned_agent || "—"}
          </span>
        </div>

        {/* Type + Capability */}
        <div className="w-36 shrink-0">
          <div className="text-xs text-slate-300">{task.task_type || "—"}</div>
          {task.matched_capability && (
            <div className="text-xs text-slate-500 truncate">{task.matched_capability}</div>
          )}
        </div>

        {/* Risk + Billing */}
        <div className="flex gap-1.5 shrink-0">
          <LiquidBadge tone={riskTone(task.risk_level)} size="sm" label={task.risk_level || "?"} />
          {task.billing_risk_level && task.billing_risk_level !== "none" && (
            <LiquidBadge tone={billingTone(task.billing_risk_level)} size="sm" label={`💰${task.billing_risk_level}`} />
          )}
        </div>

        {/* Duration */}
        <div className="w-16 text-xs text-slate-400 text-right shrink-0">
          {formatDuration(task.duration_seconds ?? undefined)}
        </div>

        {/* Indicators */}
        <div className="flex gap-1.5 shrink-0">
          {extId && (
            <span
              className="text-xs px-1.5 py-0.5 rounded-md"
              style={{ background: "rgba(125,211,252,0.10)", color: "#7dd3fc", border: "1px solid rgba(125,211,252,0.20)" }}
              title={`External: ${extId}`}
            >
              API
            </span>
          )}
          {task.status === "external_polling" && (
            <span className="text-xs px-1.5 py-0.5 rounded-md animate-pulse"
              style={{ background: "rgba(167,139,250,0.12)", color: "#a78bfa" }}>
              polling
            </span>
          )}
          {task.status === "external_failed" && (
            <span className="text-xs px-1.5 py-0.5 rounded-md"
              style={{ background: "rgba(248,113,113,0.12)", color: "#f87171" }}>
              ext fail
            </span>
          )}
          {mem && (
            <span
              className="text-xs px-1.5 py-0.5 rounded-md"
              style={{ background: "rgba(34,197,94,0.10)", color: "#4ade80", border: "1px solid rgba(34,197,94,0.20)" }}
              title="Memory written"
            >
              MEM
            </span>
          )}
          {assets && assets.length > 0 && (
            <span
              className="text-xs px-1.5 py-0.5 rounded-md"
              style={{ background: "rgba(251,191,36,0.10)", color: "#fbbf24" }}
              title={`${assets.length} asset(s)`}
            >
              📎{assets.length}
            </span>
          )}
        </div>

        {/* Created */}
        <div className="w-20 text-xs text-slate-500 shrink-0 text-right">
          <ClientOnlyText fallback="--" render={() => formatRelative(task.created_at)} />
        </div>

        {/* Arrow */}
        <div className="shrink-0 opacity-0 group-hover:opacity-40 transition-opacity text-slate-400 text-sm">
          →
        </div>
      </div>
    </Link>
  );
}

// ─── Summary Card ────────────────────────────────────────────────────────────

function SummaryCard({ label, count, tone }: { label: string; count: number; tone: StatusTone }) {
  const BG: Record<StatusTone, string> = {
    green:  "rgba(34, 197, 94, 0.12)",
    violet: "rgba(167, 139, 250, 0.12)",
    amber:  "rgba(251, 191, 36, 0.12)",
    red:    "rgba(248, 113, 113, 0.12)",
    slate:  "rgba(100, 116, 139, 0.12)",
    cyan:   "rgba(125, 211, 252, 0.12)",
  };
  const TXT: Record<StatusTone, string> = {
    green:  "#4ade80", violet: "#a78bfa", amber: "#fbbf24",
    red:    "#f87171", slate: "#94a3b8", cyan: "#7dd3fc",
  };
  return (
    <div className="rounded-xl p-3 text-center"
      style={{ background: BG[tone], border: `1px solid ${BG[tone].replace("0.12","0.22")}` }}>
      <div className="text-xl font-bold" style={{ color: TXT[tone] }}>{count}</div>
      <div className="text-xs text-slate-400 mt-0.5">{label}</div>
    </div>
  );
}

// ─── Right Stats Panel ───────────────────────────────────────────────────────

function StatsPanel({ tasks }: { tasks: Task[] }) {
  // Agent breakdown
  const agentCounts: Record<string, number> = {};
  const statusCounts: Record<string, number> = {};
  tasks.forEach(t => {
    agentCounts[t.assigned_agent || "—"] = (agentCounts[t.assigned_agent || "—"] || 0) + 1;
    statusCounts[t.status] = (statusCounts[t.status] || 0) + 1;
  });

  const topAgents = Object.entries(agentCounts).sort((a, b) => b[1] - a[1]).slice(0, 5);
  const topStatuses = Object.entries(statusCounts).sort((a, b) => b[1] - a[1]).slice(0, 6);

  const extCount   = tasks.filter(t => isExternal(t.status)).length;
  const failCount  = tasks.filter(t => t.status === "failed").length;
  const recoverCount = tasks.filter(t => isRecoverable(t.status)).length;
  const billRiskCount = tasks.filter(t => isBillingRisk(t)).length;

  return (
    <div className="flex flex-col gap-3">
      {/* External paid API */}
      {extCount > 0 && (
        <div className="rounded-xl p-3" style={{ background: "rgba(125,211,252,0.08)", border: "1px solid rgba(125,211,252,0.16)" }}>
          <div className="text-xs text-slate-500 mb-2">External Paid APIs</div>
          <div className="text-2xl font-bold text-cyan-400">{extCount}</div>
          <div className="text-xs text-slate-500">active / polling / failed</div>
        </div>
      )}

      {/* Recoverable */}
      {recoverCount > 0 && (
        <div className="rounded-xl p-3" style={{ background: "rgba(251,191,36,0.08)", border: "1px solid rgba(251,191,36,0.16)" }}>
          <div className="text-xs text-slate-500 mb-2">Recoverable</div>
          <div className="text-2xl font-bold text-amber-400">{recoverCount}</div>
          <div className="text-xs text-slate-500">timeout tasks</div>
        </div>
      )}

      {/* Failed */}
      {failCount > 0 && (
        <div className="rounded-xl p-3" style={{ background: "rgba(248,113,113,0.08)", border: "1px solid rgba(248,113,113,0.16)" }}>
          <div className="text-xs text-slate-500 mb-2">Failed</div>
          <div className="text-2xl font-bold text-red-400">{failCount}</div>
          <div className="text-xs text-slate-500">need attention</div>
        </div>
      )}

      {/* Billing Risk */}
      {billRiskCount > 0 && (
        <div className="rounded-xl p-3" style={{ background: "rgba(251,146,60,0.08)", border: "1px solid rgba(251,146,60,0.16)" }}>
          <div className="text-xs text-slate-500 mb-2">Billing Risk</div>
          <div className="text-2xl font-bold" style={{ color: "#fb923c" }}>{billRiskCount}</div>
          <div className="text-xs text-slate-500">medium / high</div>
        </div>
      )}

      {/* Agent breakdown */}
      <div className="rounded-xl p-3" style={{ background: "rgba(8,12,22,0.42)", border: "1px solid rgba(148,163,184,0.10)" }}>
        <div className="text-xs text-slate-500 mb-2">By Agent</div>
        <div className="space-y-1.5">
          {topAgents.map(([agent, count]) => (
            <div key={agent} className="flex items-center justify-between">
              <span className="text-xs text-slate-300 truncate">{agent}</span>
              <span className="text-xs text-slate-500 ml-2">{count}</span>
            </div>
          ))}
        </div>
      </div>

      {/* Status breakdown */}
      <div className="rounded-xl p-3" style={{ background: "rgba(8,12,22,0.42)", border: "1px solid rgba(148,163,184,0.10)" }}>
        <div className="text-xs text-slate-500 mb-2">By Status</div>
        <div className="space-y-1.5">
          {topStatuses.map(([status, count]) => {
            const sc = getStatus(status);
            return (
              <div key={status} className="flex items-center justify-between">
                <LiquidBadge tone={sc.tone} size="sm" label={sc.short} />
                <span className="text-xs text-slate-500 ml-2">{count}</span>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  );
}

// ─── Page ───────────────────────────────────────────────────────────────────

const API_BASE = "/api";

export default function TasksPage() {
  const [tasks, setTasks]       = useState<Task[]>([]);
  const [loading, setLoading]   = useState(true);
  const [error, setError]       = useState<string | null>(null);
  const [filter, setFilter]     = useState("all");

  const fetchTasks = useCallback(async () => {
    try {
      const res = await fetch(`${API_BASE}/tasks?limit=200`, { cache: "no-store" });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      const json = await res.json();
      const rows = getArray<Task>(json.data, []);
      setTasks(rows);
      setError(null);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Connection failed");
    } finally {
      setLoading(false);
    }
  }, []);

  useEffect(() => {
    fetchTasks();
    const id = setInterval(fetchTasks, 8000);
    return () => clearInterval(id);
  }, [fetchTasks]);

  // ── Counts ────────────────────────────────────────────────────────────────
  const counts = {
    all:          tasks.length,
    running:      tasks.filter(t => t.status === "running").length,
    pending:      tasks.filter(t => t.status === "pending" || t.status === "waiting_for_agent").length,
    confirm:      tasks.filter(t => t.status === "pending_confirmation").length,
    external:     tasks.filter(t => isExternal(t.status)).length,
    recoverable:   tasks.filter(t => isRecoverable(t.status)).length,
    completed:    tasks.filter(t => t.status === "completed").length,
    failed:       tasks.filter(t => t.status === "failed").length,
    high_risk:    tasks.filter(t => isHighRisk(t)).length,
    billing_risk: tasks.filter(t => isBillingRisk(t)).length,
    cancelled:    tasks.filter(t => t.status === "cancelled" || t.status === "invalidated").length,
  };

  const filtered = tasks.filter(t => matchFilter(t, filter));

  return (
    <LiquidBackground mode="dark" className="min-h-screen">
      <div className="flex flex-col h-screen p-4 gap-3 overflow-hidden">

        {/* ── Top Bar ── */}
        <LiquidPanel variant="chrome" className="shrink-0 px-5 py-3">
          <div className="flex items-center justify-between">
            <div className="flex items-center gap-3">
              <span className="text-base text-slate-100 font-semibold">Task Operations</span>
              {!loading && !error && (
                <span className="text-xs text-slate-500">
                  {tasks.length} tasks · refreshing every 8s
                </span>
              )}
            </div>
            {error ? (
              <div className="flex items-center gap-2">
                <span className="text-xs text-red-400">⚠ {error}</span>
                <button onClick={fetchTasks}
                  className="text-xs px-3 py-1 rounded-lg text-red-400 border border-red-400/30 hover:bg-red-400/10 transition-colors">
                  Retry
                </button>
              </div>
            ) : (
              <div className="flex items-center gap-1.5">
                <span className="w-1.5 h-1.5 rounded-full animate-pulse"
                  style={{ background: "#22c55e", boxShadow: "0 0 6px #22c55e" }} />
                <span className="text-xs text-slate-500">Live</span>
              </div>
            )}
          </div>
        </LiquidPanel>

        {/* ── KPI Row ── */}
        {!loading && !error && (
          <div className="grid grid-cols-8 gap-2 shrink-0">
            <SummaryCard label="Total"       count={counts.all}          tone="cyan"   />
            <SummaryCard label="Running"     count={counts.running}      tone="violet" />
            <SummaryCard label="Pending"     count={counts.pending}     tone="amber"  />
            <SummaryCard label="Confirm"     count={counts.confirm}      tone="red"    />
            <SummaryCard label="External"    count={counts.external}     tone="cyan"   />
            <SummaryCard label="Recoverable" count={counts.recoverable} tone="amber"  />
            <SummaryCard label="Completed"   count={counts.completed}   tone="green"  />
            <SummaryCard label="Failed"      count={counts.failed}       tone="red"    />
          </div>
        )}

        {/* ── Main ── */}
        <div className="flex gap-3 flex-1 min-h-0">

          {/* ── Left: Filters + Table ── */}
          <div className="flex flex-col gap-3 flex-1 min-w-0">

            {/* Filter tabs */}
            <LiquidPanel variant="dark" className="shrink-0 px-3 py-2">
              <div className="flex items-center gap-1 overflow-x-auto pb-0.5">
                {FILTERS.map(f => {
                  const active = filter === f.key;
                  return (
                    <button key={f.key} onClick={() => setFilter(f.key)}
                      className={`shrink-0 px-3 py-1.5 rounded-lg text-xs font-medium transition-all ${active ? "text-white" : "text-slate-500 hover:text-slate-300"}`}
                      style={active ? {
                        background: "rgba(125, 211, 252, 0.16)",
                        border: "1px solid rgba(125, 211, 252, 0.30)",
                        color: "#7dd3fc",
                      } : {
                        background: "transparent",
                        border: "1px solid transparent",
                      }}>
                      {f.label}
                      <span className="ml-1.5 px-1.5 py-0.5 rounded-full text-xs"
                        style={{
                          background: active ? "rgba(125,211,252,0.20)" : "rgba(148,163,184,0.10)",
                          color: active ? "#7dd3fc" : "#64748b",
                        }}>
                        {counts[f.key as keyof typeof counts] ?? 0}
                      </span>
                    </button>
                  );
                })}
              </div>
            </LiquidPanel>

            {/* Table header */}
            {!loading && !error && (
              <div className="flex items-center gap-3 px-4 py-1.5 text-xs text-slate-500 uppercase tracking-wider shrink-0">
                <div className="w-28 shrink-0">Status</div>
                <div className="w-44 shrink-0">Task ID / Project</div>
                <div className="w-28 shrink-0">Agent</div>
                <div className="w-36 shrink-0">Type / Capability</div>
                <div className="shrink-0">Risk / Billing</div>
                <div className="w-16 shrink-0 text-right">Dur</div>
                <div className="shrink-0">Indicators</div>
                <div className="w-20 shrink-0 text-right">Created</div>
                <div className="w-4 shrink-0" />
              </div>
            )}

            {/* Task list */}
            <div className="flex-1 overflow-y-auto min-h-0 space-y-1.5 pr-1">
              {loading ? (
                <div className="flex items-center justify-center h-full">
                  <div className="text-center text-slate-500 text-sm">
                    <div className="text-2xl mb-2">◈</div>
                    <div>Syncing tasks…</div>
                  </div>
                </div>
              ) : error ? (
                <div className="flex items-center justify-center h-full">
                  <div className="text-center">
                    <div className="text-red-400 text-sm mb-2">⚠ {error}</div>
                    <button onClick={fetchTasks}
                      className="text-xs px-4 py-2 rounded-lg text-red-400 border border-red-400/30 hover:bg-red-400/10 transition-colors">
                      Retry
                    </button>
                  </div>
                </div>
              ) : filtered.length === 0 ? (
                <div className="flex items-center justify-center h-full">
                  <div className="text-center text-slate-500 text-sm">
                    <div className="text-2xl mb-2">🤖</div>
                    <div>No tasks match: {filter}</div>
                  </div>
                </div>
              ) : (
                filtered.map(task => <TaskRow key={task.id} task={task} />)
              )}
            </div>
          </div>

          {/* ── Right: Stats ── */}
          <div className="w-52 shrink-0 overflow-y-auto min-h-0">
            <LiquidPanel variant="chrome" className="h-full flex flex-col overflow-hidden">
              <div className="px-4 py-3 border-b border-white/6 shrink-0">
                <div className="text-xs text-slate-500 font-medium">Insights</div>
              </div>
              <div className="flex-1 overflow-y-auto min-h-0 p-3">
                {!loading && !error ? (
                  <StatsPanel tasks={tasks} />
                ) : (
                  <div className="text-center text-slate-600 text-xs py-8">—</div>
                )}
              </div>
            </LiquidPanel>
          </div>
        </div>
      </div>
    </LiquidBackground>
  );
}
